# Postgres connection string. Local dev uses the docker-compose `db` service.
DATABASE_URL="postgresql://learnthestack:learnthestack@localhost:5432/learnthestack"

# --- AI tutor provider ---------------------------------------------------
# Which backend the tutor uses. Defaults to Anthropic Claude when unset.
#   anthropic -> Claude Haiku 4.5 (needs ANTHROPIC_API_KEY)
#   ollama    -> local Ollama instance (free, private, offline)
#TUTOR_PROVIDER="anthropic"   # Claude Haiku 4.5 (default; needs ANTHROPIC_API_KEY)
TUTOR_PROVIDER="ollama"       # your local Ollama (OLLAMA_BASE_URL, OLLAMA_MODEL)
# Required when TUTOR_PROVIDER=anthropic. Get one at:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Used when TUTOR_PROVIDER=ollama. Pick a tool-capable model (qwen2.5, llama3.1)
# if you want the tutor's tools to work locally.
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="qwen2.5:32b"
